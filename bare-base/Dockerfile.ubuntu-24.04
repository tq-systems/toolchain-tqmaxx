ARG registry_base_url=registry.example.com:5005/registry-path
FROM ${registry_base_url}/base:ubuntu-24.04

# Large packages should come first
RUN \
	for TC_VER in 12.2.rel1 13.2.rel1 14.2.rel1 15.2.rel1; do \
		TC=arm-gnu-toolchain-${TC_VER}-x86_64-arm-none-eabi.tar.xz && \
		wget https://developer.arm.com/-/media/Files/downloads/gnu/${TC_VER}/binrel/${TC} && \
		tar --xz -xf ${TC} --directory /opt && \
		rm ${TC}; \
	done
	
RUN \
	wget https://github.com/Kitware/CMake/releases/download/v3.31.4/cmake-3.31.4-linux-x86_64.tar.gz && \
	tar --gzip -xf cmake-3.31.4-linux-x86_64.tar.gz --directory /opt && \
	rm cmake-3.31.4-linux-x86_64.tar.gz

# ninja for up to date NXP SDK
RUN \
	wget https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-linux.zip && \
	mkdir -p /opt/ninja-v1.12.1 && \
	gunzip -c ninja-linux.zip > /opt/ninja-v1.12.1/ninja && \
	rm ninja-linux.zip && \
	chmod ugoa+x /opt/ninja-v1.12.1/ninja

#compilers are also large and seldom updated
RUN \
	echo "deb [trusted=yes] http://debian.pengutronix.de/debian/ noble main" >> /etc/apt/sources.list && \
	apt-get update && \
	apt-get install -y \
		oselas.toolchain-2024.11.1-aarch64-v8a-linux-gnu \
		oselas.toolchain-2024.11.1-arm-v7a-linux-gnueabihf \
		oselas.toolchain-2024.11.1-powerpc-603e-linux-gnu \
		pengutronix-archive-keyring

RUN \
	apt-get update && apt-get -y upgrade && \
	apt-get install -y \
		bison \
		cmake \
		device-tree-compiler \
		flex \
		git-lfs \
		libgnutls28-dev \
		libssl-dev \
		lzop \
		pipx \
		python3 \
		python3-dev \
		python3-importlib-resources \
		python3-jsonschema \
		python3-pip \
		python3-pyelftools \
		python3-setuptools \
		python3-venv \
		yamllint \
		swig \
		tree \
		uuid-dev \
		xz-utils \
		xxd \
		zip \
		zlib1g-dev \
		zstd && \
	apt-get autoremove --yes && apt-get clean --yes && \
	rm -rf /var/lib/apt/lists/*

# zephyr's meta repo management and python kconfig library needed for NXP MCU SDK
RUN \
	pipx install west && \
	pipx install kconfiglib
